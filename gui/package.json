{
  "name": "dvbfixer-gui",
  "private": true,
  "version": "0.8.6",
  "description": "Graphical workspace for DVBfixer structure preparation and homology modeling",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scarfSettings": {
    "enabled": false
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "@parcel/watcher": false,
    "@scarf/scarf": false,
    "fsevents": false
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:no-db": "vite",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f db",
    "build": "npm run check:openapi && npm run typecheck && npm run build:client && npm run build:server && npm run smoke:server",
    "build:client": "vite build",
    "build:server": "esbuild server/standalone.ts --bundle --platform=node --format=esm --target=node22 --packages=external --sourcemap --outfile=dist-server/server.js",
    "start": "node --enable-source-maps dist-server/server.js",
    "smoke:server": "node scripts/smoke-standalone.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "postinstall": "node scripts/fix-native-deps.mjs",
    "gen:openapi": "node scripts/gen-openapi-client.mjs",
    "check:openapi": "node scripts/gen-openapi-client.mjs --check"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.11",
    "@mui/material": "^7.3.11",
    "@mui/x-data-grid": "^8.28.6",
    "@rollup/wasm-node": "^4.60.1",
    "@sinclair/typebox": "^0.34.52",
    "@types/pg": "^8.20.0",
    "connect": "^3.7.0",
    "flexlayout-react": "^0.8.19",
    "molstar": "^5.8.0",
    "openapi-fetch": "^0.17.0",
    "pg": "^8.21.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sass": "^1.99.0",
    "serve-static": "^2.2.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/connect": "^3.4.38",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/serve-static": "^2.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.4"
  }
}
