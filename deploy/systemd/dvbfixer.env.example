DVBFIXER_GUI_ROOT=/opt/dvbfixer/gui
DVBFIXER_STATIC_DIR=/opt/dvbfixer/gui/dist
DVBFIXER_GUI_DATA_DIR=/var/lib/dvbfixer
DVBFIXER_MUTATIONS_BACKUP_FILE=/var/lib/dvbfixer/mutations.json
DVBFIXER_HOST=127.0.0.1
DVBFIXER_PORT=5173
DVBFIXER_MAX_CONCURRENT_PROCESSES=1
DVBFIXER_ACCESS_LOG=json
DVBFIXER_METRICS=prometheus
DVBFIXER_OS_RESOURCE_LIMITS_REQUIRED=1
DVBFIXER_OS_DATA_FILESYSTEM_MAX_BYTES=68719476736
DVBFIXER_OS_TEMP_FILESYSTEM_MAX_BYTES=8589934592
DVBFIXER_OS_CPU_QUOTA_PERCENT=200
DVBFIXER_OS_MEMORY_MAX_BYTES=17179869184
DVBFIXER_OS_MEMORY_SWAP_MAX_BYTES=0
DVBFIXER_OS_TASKS_MAX=512
TMPDIR=/var/lib/dvbfixer/tmp
HOME=/var/lib/dvbfixer/home
XDG_CACHE_HOME=/var/lib/dvbfixer/cache
PATH=/opt/mamba/envs/dvbfixer/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin

# Add deployment-specific authentication, CORS, database, and Modeller settings.
# DVBFIXER_AUTH_PRINCIPALS={"version":1,"principals":[...]}
# DVBFIXER_LEGACY_WORKSPACE_OWNER=owner
# DVBFIXER_CORS_ALLOWED_ORIGINS=["https://dvbfixer.example.org"]
# DATABASE_URL=postgresql://...
