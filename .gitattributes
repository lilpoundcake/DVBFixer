# PDB is a fixed-column format; trailing spaces may be meaningful padding.
tests/fixtures/**/*.pdb whitespace=-blank-at-eol

# Preserve source FASTA files byte-for-byte, including an optional final blank line.
tests/fixtures/**/*.fasta whitespace=-blank-at-eof

# Unified diffs use a single-space context marker for blank source lines.
deploy/**/*.patch whitespace=-blank-at-eol
